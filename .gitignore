# ─────────────────────────────────────────────────────
# DATOS SENSIBLES — nunca subir al repositorio
# ─────────────────────────────────────────────────────

# Carpetas de datos operativos
glpi/
partes/
pl/
logs/
perfil_whatsapp/
perfil_monitor/
Control de Versiones/

# Archivos Excel con datos reales
*.xlsx
*.xls
*.csv

# Archivos de estado y logs del bot
*.log
*.json
*.txt

# Imágenes de capturas del bot
*.png
*.jpg
*.jpeg

# Archivos Word con propuestas/documentación interna
*.docx
*.doc

# Archivos temporales de Excel (empiezan con ~$)
~$*

# ─────────────────────────────────────────────────────
# ARCHIVOS DEL SISTEMA
# ─────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
.venv
venv/
.vscode/
*.code-workspace
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# ─────────────────────────────────────────────────────
# MODELOS ENTRENADOS (datos privados compilados)
# ─────────────────────────────────────────────────────
modelos/*.joblib

# ─────────────────────────────────────────────────────
# EXCEPCIONES — estos SÍ deben estar en el repo
# ─────────────────────────────────────────────────────
!*.py
!*.bat
!*.md
!requirements.txt
!.gitignore

# Carpetas vacías con placeholder
!glpi/.gitkeep
!partes/.gitkeep
!pl/.gitkeep
!modelos/.gitkeep

